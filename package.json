{
  "name": "sequelize-tinker",
  "description": "A REPL for sequelize inspired by Laravel Tinker.",
  "version": "0.5.0",
  "author": "nitaking @nitaking",
  "bin": {
    "sequelize-tinker": "./bin/run"
  },
  "bugs": "https://github.com/nitaking/sequelize-tinker/issues",
  "type": "module",
  "dependencies": {
    "@oclif/command": "^1.8.36",
    "@oclif/config": "^1.18.17",
    "@oclif/errors": "^1.3.6",
    "@oclif/help": "^1.0.15",
    "@oclif/plugin-help": "^3",
    "conf": "^6.0.1"
  },
  "devDependencies": {
    "chai": "^4",
    "eslint": "^5.13",
    "eslint-config-oclif": "3.1.0",
    "execa": "^4.0.0",
    "mocha": "^10",
    "nyc": "^17"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "/bin",
    "/src"
  ],
  "homepage": "https://github.com/nitaking/sequelize-tinker",
  "keywords": [
    "oclif",
    "node",
    "laravel-tinker",
    "rails-console",
    "node-tinker",
    "sequelize",
    "sequelize-tinker"
  ],
  "license": "MIT",
  "main": "src/index.js",
  "oclif": {
    "bin": "sequelize-tinker"
  },
  "repository": "nitaking/sequelize-tinker",
  "scripts": {
    "posttest": "eslint src",
    "test": "nyc mocha --forbid-only \"test/**/*.test.js\"",
    "lint:fix": "eslint src --fix"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.5.1"
}
